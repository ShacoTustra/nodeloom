      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Result of the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NanoBananaEditOutput"
        }
       }
      }
     }
    }
   }
  }
 },
