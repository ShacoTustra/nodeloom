      "type": "string"
     },
     "end_image_url": {
      "title": "End Image Url",
      "anyOf": [
       {
        "type": "string",
        "ui": {
         "field": "image"
        }
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional URL of the image to use as the last frame of the video"
     },
     "prompt_optimizer": {
      "type": "boolean",
      "title": "Prompt Optimizer",
      "default": true,
      "description": "Whether to use the model's prompt optimizer"
     },
     "duration": {
      "type": "string",
      "title": "Duration",
      "default": "6",
      "enum": [
       "6",
       "10"
      ],
      "description": "The duration of the video in seconds. 10 seconds videos are not supported for 1080p resolution."
     },
     "resolution": {
      "type": "string",
      "title": "Resolution",
      "default": "768P",
      "enum": [
       "512P",
       "768P"
      ],
      "description": "The resolution of the generated video."
     },
     "enable_safety_checker": {
      "type": "boolean",
      "title": "Enable Safety Checker",
      "default": true,
      "description": "Authorized callers may set false to request relaxed screening."
     },
     "prompt": {
      "examples": [
       "Man walked into winter cave with polar bear"
      ],
      "title": "Prompt",
      "type": "string",
      "maxLength": 2000
     }
    },
    "required": [
     "prompt",
     "image_url"
    ]
   },
   "MinimaxHailuo02StandardImageToVideoOutput": {
    "x-fal-order-properties": [
     "video"
    ],
    "type": "object",
    "title": "ImageToVideoHailuo02Output",
    "properties": {
     "video": {
      "examples": [
       {
        "url": "https://v3.fal.media/files/monkey/xF9OsLwGjjNURyAxD8RM1_output.mp4"
       }
      ],
      "$ref": "#/components/schemas/File",
      "description": "The generated video"
     }
    },
    "required": [
     "video"
    ]
   },
   "File": {
    "x-fal-order-properties": [
     "url",
     "content_type",
     "file_name",
     "file_size"
    ],
    "type": "object",
    "title": "File",
